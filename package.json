{
  "name": "forgefit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Offline-first iPhone workout tracker. Zero runtime dependencies.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc && node scripts/build.mjs",
    "test": "node --test tests/model.test.mjs",
    "preview": "node scripts/serve.mjs",
    "test:package": "node --test tests/package.test.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=20.11"
  }
}
